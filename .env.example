# Copy to .env and fill in. Never commit .env (it's gitignored).

# Comma-separated Greenhouse board tokens -- the slug in a company's careers URL,
# e.g. https://boards.greenhouse.io/stripe -> "stripe".
# Not a secret in itself (Greenhouse's Job Board API is public/unauthenticated),
# but kept in .env / GitHub Actions secrets anyway so the list of companies
# you're tracking isn't sitting in plaintext in a public repo's workflow file.
GREENHOUSE_BOARD_TOKENS=stripe,airbnb,figma

# The spreadsheet id from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# Tab/worksheet name within that spreadsheet. Must already exist (this project
# does not create it), with a header row matching jobscraper/models.py FIELDS:
# board, job_id, title, department, location, url, updated_at, scraped_date
GOOGLE_SHEET_WORKSHEET_NAME=Jobs

# The full service account JSON key file's contents, as ONE LINE.
#
# How to get one:
#   1. In Google Cloud Console, in a project: APIs & Services -> Library ->
#      enable "Google Sheets API".
#   2. IAM & Admin -> Service Accounts -> Create service account (any name).
#   3. Open that service account -> Keys -> Add key -> Create new key -> JSON.
#      This downloads a .json file -- do NOT commit it anywhere.
#   4. Open the target Google Sheet -> Share -> paste the service account's
#      client_email (looks like ...@<project-id>.iam.gserviceaccount.com) and
#      give it Editor access. Without this share step every write fails with
#      a permission error, no matter how correct the credentials are.
#   5. Collapse the downloaded JSON to one line and paste it here, e.g.:
#      python -c "import json;print(json.dumps(json.load(open('key.json'))))"
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# How many days of history to keep in the sheet. A run deletes any row whose
# scraped_date is older than today minus this many days.
PRUNE_AFTER_DAYS=60
