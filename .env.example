# Copy to .env; never commit credentials. Setup instructions are in README.md.
# Board configuration lives in company_toml/*_boards.toml.

# Required for sheet commands: spreadsheet URL ID and complete service-account JSON.
# Store the JSON on one line, enclosed in single quotes if needed by dotenv.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional exact title check before reading or writing the spreadsheet.
GOOGLE_SHEET_TITLE=

# Each Telegram destination needs this token and its chat ID. Topic IDs are optional.
TELEGRAM_BOT_TOKEN=

# Grouped counts of new PAC DA/BI, DS/ML/Algos and SWE/DE postings.
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Announce new firms from the Supported companies tab.
TELEGRAM_COMPANIES_CHAT_ID=
TELEGRAM_COMPANIES_THREAD_ID=

# Individual SG/HK data-engineering roles; the recipient must start the bot first.
# Descriptions are included only for firms in FIRMS_NEEDING_DESCRIPTION.
TELEGRAM_DM_CHAT_ID=

# Optional comma-separated firms for daily fetching and board-health checks.
# Does not restrict the Supported companies reference tab.
ONLY_FIRMS=

# One-run override for held-back firms, after confirming closures. Leave blank normally.
FORCE_PRUNE_FIRMS=
