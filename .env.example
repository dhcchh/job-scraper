# Copy to .env and fill in. Never commit .env (it's gitignored).

# Greenhouse board tokens are NOT configured here -- see
# company_toml/greenhouse_boards.toml instead. They aren't secret, so they
# live in a plain checked-in file that's easy to read and edit as the list
# grows.

# The spreadsheet id from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
#
# This project writes one tab per (role category x PAC/RoW region) pair --
# see jobscraper/enrichment/classify_roles.py CATEGORIES and
# classify_region.py REGIONS for the current full list, named exactly
# "{category} - {region}" (e.g. "SWE/DE - PAC"). Each tab must already exist
# (this project does not create tabs) with a header row matching
# jobscraper/models.py FIELDS EXACTLY, in this order -- rows are written by
# position, so append_jobs/plan_prune refuse a tab whose header differs:
# first_published, updated_at, board, title, location, seniority, company_type, url, salary, department, job_id, scraped_date, source, description
GOOGLE_SHEET_ID=

# Optional: the spreadsheet's exact display title (as shown in the browser
# tab / Drive), e.g. "Job Board Tracker". GOOGLE_SHEET_ID is set
# independently here and in the GitHub Actions secret, and nothing else
# cross-checks the two -- if one drifts, this project would otherwise
# silently write/prune real data against the wrong file while still
# reporting a clean run. When set, get_spreadsheet() refuses to run if the
# opened spreadsheet's title doesn't match. Leave blank to skip this check.
GOOGLE_SHEET_TITLE=

# The full service account JSON key file's contents, as ONE LINE.
#
# How to get one:
#   1. In Google Cloud Console, in a project: APIs & Services -> Library ->
#      enable "Google Sheets API".
#   2. IAM & Admin -> Service Accounts -> Create service account (any name).
#   3. Open that service account -> Keys -> Add key -> Create new key -> JSON.
#      This downloads a .json file -- do NOT commit it anywhere.
#   4. Open the target Google Sheet -> Share -> paste the service account's
#      client_email (looks like ...@<project-id>.iam.gserviceaccount.com) and
#      give it Editor access. Without this share step every write fails with
#      a permission error, no matter how correct the credentials are.
#   5. Collapse the downloaded JSON to one line and paste it here, e.g.:
#      python -c "import json;print(json.dumps(json.load(open('key.json'))))"
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

# Optional: a Telegram digest of this run's newly appended DA/BI,
# DS/ML/Algos, and SWE/DE postings (PAC region only) -- see telegram.py.
# Leave any of the three unset/blank to disable the feature entirely; no
# other .env value is affected either way.
#
# TELEGRAM_BOT_TOKEN can be the exact same @BotFather bot token as a
# separate Telegram community bot you already run elsewhere (e.g.
# data-career-hustler-bot) -- a bot token isn't tied to one chat. Get one
# from @BotFather if you don't have one: /newbot, then copy the token it
# gives you.
#
# TELEGRAM_CHAT_ID is the destination chat/supergroup id (a group id starts
# with -100...; get it by adding the bot to the chat and checking
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending any message
# there). TELEGRAM_THREAD_ID is that chat's forum-topic id, only needed if
# the chat has topics enabled -- omit it to post to the chat's main/General
# stream instead of a specific topic.
#
# If you're pointing this at the same supergroup a community bot like
# data-career-hustler-bot already posts to, use a DIFFERENT topic than that
# bot's own jobs topic -- these are unreviewed scraped postings, not the
# same thing as that bot's member-curated listings, and mixing the two
# would make the manual topic unreadable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# Optional: a one-off "N new companies added to the job tracker" message
# whenever a firm is added to a company_toml/*_boards.toml file, sent by the
# same TELEGRAM_BOT_TOKEN bot to its own chat/topic (a firm counts as new
# when the "Supported companies" tab didn't list it yet -- see
# sheets/supported_companies.py). Leave TELEGRAM_COMPANIES_CHAT_ID blank to
# disable just this; TELEGRAM_COMPANIES_THREAD_ID is the forum-topic id, same
# idea as TELEGRAM_THREAD_ID above.
TELEGRAM_COMPANIES_CHAT_ID=
TELEGRAM_COMPANIES_THREAD_ID=

# Optional: a DM per new Singapore/Hong Kong data-engineering role (data
# engineer, data-flavoured software engineer, analytics engineer), with its
# apply link and full JD -- see alerts.py. Your own numeric Telegram user id
# (e.g. from @userinfobot). Open TELEGRAM_BOT_TOKEN's bot and press Start
# first: a bot can't message someone who hasn't. Blank disables just this.
TELEGRAM_DM_CHAT_ID=

# Optional, one run only: comma-separated firm names whose held-back prune
# (a board that returned no postings, or would lose over half its tracked
# rows at once -- see sheets/writer.py held_back_prunes) should go ahead
# anyway, after confirming those postings really closed. Leave blank.
FORCE_PRUNE_FIRMS=
