# Secrets / local env
.env

# Downloaded GCP service-account key files (e.g. job-scraper-xxxxx.json) --
# this project has no legitimate json files of its own, so blanket-ignoring
# is the safer default. `git add -f` if you ever need a real one tracked.
*.json

# Python
__pycache__/
*.py[cod]
*.egg-info

# Virtual environment
.venv/

# Test / tooling caches
.pytest_cache/
.hypothesis/
.ruff_cache/

# Editor/agent local settings
.claude/settings.local.json
